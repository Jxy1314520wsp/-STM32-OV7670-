#include "OV7670.h"
#include "delay.h"
#include <stddef.h>
#include <string.h>

/* OV7670 control signals. Change these definitions with the PCB wiring. */
#define OV7670_RESET_PORT       GPIOC
#define OV7670_RESET_PIN        GPIO_PIN_4
#define OV7670_PWDN_PORT        GPIOC
#define OV7670_PWDN_PIN         GPIO_PIN_5

#define OV7670_SIOC_PORT        GPIOB
#define OV7670_SIOC_PIN         GPIO_PIN_10
#define OV7670_SIOD_PORT        GPIOB
#define OV7670_SIOD_PIN         GPIO_PIN_11

#define OV7670_SCCB_DELAY_US    3U
#define OV7670_CONFIG_DELAY_US  100U
#define OV7670_ID_PID           0x76U
#define OV7670_ID_VER           0x73U

typedef struct
{
    uint8_t reg;
    uint8_t value;
} OV7670_RegValueTypeDef;

DCMI_HandleTypeDef hdcmi;
DMA_HandleTypeDef hdma_dcmi;

/* Four-byte alignment is guaranteed by the uint32_t element type. DCMI DMA
 * writes one 32-bit word for every four bytes received from the sensor. */
static uint32_t s_frame_buffer[OV7670_FRAME_WORDS];
static volatile uint8_t s_frame_ready = 0U;
static volatile uint32_t s_last_error = HAL_DCMI_ERROR_NONE;
static uint8_t s_initialized = 0U;
static uint8_t s_dcmi_msp_initialized = 0U;

